{
  "name": "hearth-chat-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:standalone": "tsc -b && vite build --config vite.standalone.config.ts && node -e \"const fs=require('fs');fs.renameSync('dist-standalone/index.html','dist-standalone/hearth-full.html');fs.copyFileSync('standalone-launcher.bat','dist-standalone/Start Hearth.bat')\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri"
  },
