{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "hearth",
  "version": "0.1.2",
  "identifier": "net.plutoguy.hearth",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Hearth",
        "width": 1280,
        "height": 860,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzOTY5NDU5RTYzNjgzQkIKUldTN2d6Ym1XWlNXVThNVHZOVm5ydDZzd2lMVGVTZjdzM2Y2dDh3ZFl5VjZJWmlUcWozMEtiZUEK",
      "endpoints": [
        "https://github.com/PlutoGuyy/hearth-chat-app/releases/latest/download/latest.json"
      ]
    }
  }
}
